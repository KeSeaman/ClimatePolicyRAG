"""Type stubs for the Rust extension module (src/*.rs)."""

from collections.abc import Sequence
from os import PathLike

import numpy as np
from numpy.typing import NDArray

# float32 NumPy arrays are read in place; other sequences are converted element by element.
Vector = NDArray[np.float32] | Sequence[float]
Matrix = NDArray[np.float32] | Sequence[Sequence[float]]

class Document:
    id: str
    content: str
    metadata: dict[str, str]

    def __init__(
        self, id: str, content: str, metadata: dict[str, str] | None = None
    ) -> None: ...

class SearchResult:
    @property
    def doc_id(self) -> str: ...
    @property
    def score(self) -> float: ...
    @score.setter
    def score(self, value: float) -> None: ...
    @property
    def content(self) -> str: ...
    @property
    def metadata(self) -> dict[str, str]: ...

class VectorIndex:
    """In-memory cosine-similarity index; re-adding an id replaces that document."""

    def __init__(self, dimension: int) -> None: ...
    @property
    def dimension(self) -> int: ...
    def add(self, doc: Document, embedding: Vector) -> None: ...
    def add_batch(self, docs: list[Document], embeddings: Matrix) -> None: ...
    def search(self, query_embedding: Vector, k: int) -> list[SearchResult]: ...
    def keyword_search(self, query: str, k: int) -> list[SearchResult]:
        """BM25 over document content; only documents sharing a query term are returned."""
        ...
    def ids(self) -> list[str]: ...
    def save(self, dir: str | PathLike[str]) -> None: ...
    @staticmethod
    def load(dir: str | PathLike[str], dimension: int) -> VectorIndex: ...
    def __len__(self) -> int: ...
    def __contains__(self, doc_id: str) -> bool: ...
